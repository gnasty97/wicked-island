<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WickedIsland.Mods</AssemblyName>
    <RootNamespace>WickedIsland.Mods</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(BEPINEX_DIR)</BepInExDir>
    <UnityManagedDir Condition="'$(UnityManagedDir)' == ''">$(WICKED_ISLAND_MANAGED_DIR)</UnityManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')"
           Text="BepInEx.dll not found. Set BepInExDir (or BEPINEX_DIR env var) to your game's BepInEx folder." />
    <Error Condition="!Exists('$(UnityManagedDir)\UnityEngine.CoreModule.dll')"
           Text="UnityEngine.CoreModule.dll not found. Set UnityManagedDir (or WICKED_ISLAND_MANAGED_DIR env var) to Wicked Island's *_Data\Managed folder." />
  </Target>
</Project>
